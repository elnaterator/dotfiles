[project]
name = "{{PROJECT_NAME}}"
version = "0.1.0"
description = "{{PROJECT_DESCRIPTION}}"
readme = "README.md"
requires-python = ">=3.14"
dependencies = []

[project.scripts]
{{PROJECT_NAME}} = "{{PACKAGE}}.main:main"

[dependency-groups]
dev = [
    "pytest>=9",
    "pytest-cov>=7",
    "ruff>=0.16",
    "mypy>=2",
    "bandit>=1.9",
    "pip-audit>=2.10",
    "pre-commit>=4",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{PACKAGE}}"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
# E/W pycodestyle, F pyflakes, I isort, UP pyupgrade, B bugbear
select = ["E", "W", "F", "I", "UP", "B"]

[tool.mypy]
python_version = "3.14"
strict = true

[tool.bandit]
exclude_dirs = ["tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--cov={{PACKAGE}} --cov-report=term-missing"

[tool.coverage.run]
source = ["src/{{PACKAGE}}"]

[tool.coverage.report]
show_missing = true
fail_under = 80
