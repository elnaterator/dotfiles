#!/usr/bin/env bash
#
# Package AI agent skills into zip archives for upload to Claude Code,
# Claude Cowork, or other agent editors.
#
# One zip per skill, written to ~/skills/<name>.zip by default.
#
# Skills are found in the current directory: either ./skills/, or the current
# directory itself if it holds the skill folders. If neither matches you are
# prompted for a path, which is resolved the same way — so a repo root or a
# skills directory both work, here and for --skills-dir.
#
# When the skills directory is inside a git repo, the file list comes from git,
# so anything ignored by .gitignore is left out of the archive (e.g. private
# material under write-like-me/samples/).
#
# Usage:
#   zip-skills                    Interactive picker (space to toggle, enter to zip)
#   zip-skills --all              Zip every skill, no prompts
#   zip-skills write-like-me      Zip named skill(s)
#   zip-skills --list             List available skills
#   zip-skills --clean            Delete zips in the output directory
#
# Options:
#   -s, --skills-dir PATH   Repo root or skills dir (default: ./skills or .)
#   -o, --output PATH       Directory to write zips to (default: ~/skills)
#   -a, --all               Select every skill
#   -l, --list              Print skill names and exit
#       --clean             Delete *.zip in the output directory and exit
#   -h, --help              Show this help
#

set -euo pipefail

SKILLS_DIR=""
OUT_DIR="$HOME/skills"
git_mode=0

saved_stty=""
cursor=0
selected_count=0
skill_names=()
selected_flags=()

usage() {
    # Print the header comment block (everything after the shebang up to the
    # first non-comment line), stripped of its leading '# '.
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

cleanup_terminal() {
    if [ -n "$saved_stty" ]; then
        stty "$saved_stty"
    fi
    tput cnorm 2>/dev/null || true
}

# True if the directory directly contains at least one */SKILL.md
holds_skills() {
    local dir=$1 candidate
    [ -d "$dir" ] || return 1
    for candidate in "$dir"/*/; do
        [ -f "${candidate}SKILL.md" ] && return 0
    done
    return 1
}

# Given a base directory, echo the absolute path of the skills directory to use:
# <base>/skills when that holds skill folders, else <base> itself. Returns 1 when
# neither does. Used for the current directory, an entered path, and
# --skills-dir alike, so any of them may name a repo root or a skills dir.
find_skills_dir() {
    local base=$1

    if holds_skills "$base/skills"; then
        (cd "$base/skills" && pwd)
        return 0
    fi
    if holds_skills "$base"; then
        (cd "$base" && pwd)
        return 0
    fi
    return 1
}

not_found_msg() {
    echo "No skills found in $1 (looked for skills/*/SKILL.md and */SKILL.md)."
}

# Resolve the skills directory: explicit --skills-dir, else the current
# directory, else prompt the user.
resolve_skills_dir() {
    local resolved answer

    if [ -n "$SKILLS_DIR" ]; then
        if [ ! -d "$SKILLS_DIR" ]; then
            echo "Error: not a directory: $SKILLS_DIR" >&2
            exit 1
        fi
        if ! resolved=$(find_skills_dir "$SKILLS_DIR"); then
            echo "Error: $(not_found_msg "$SKILLS_DIR")" >&2
            exit 1
        fi
        SKILLS_DIR=$resolved
        return
    fi

    if resolved=$(find_skills_dir "."); then
        SKILLS_DIR=$resolved
        return
    fi

    if [ ! -t 0 ]; then
        echo "Error: $(not_found_msg "$(pwd)")" >&2
        echo "Pass --skills-dir PATH when running non-interactively." >&2
        exit 1
    fi

    not_found_msg "$(pwd)" >&2
    read -r -e -p "Path to skills directory: " answer
    answer=${answer/#\~/$HOME}

    if [ -z "$answer" ]; then
        echo "Error: no path given" >&2
        exit 1
    fi
    if [ ! -d "$answer" ]; then
        echo "Error: not a directory: $answer" >&2
        exit 1
    fi
    if ! resolved=$(find_skills_dir "$answer"); then
        echo "Error: $(not_found_msg "$answer")" >&2
        exit 1
    fi

    SKILLS_DIR=$resolved
}

# A skill is any directory under the skills dir containing a SKILL.md
discover_skills() {
    local dir
    for dir in "$SKILLS_DIR"/*/; do
        [ -f "${dir}SKILL.md" ] || continue
        skill_names+=("$(basename "$dir")")
        selected_flags+=(0)
    done

    if [ ${#skill_names[@]} -eq 0 ]; then
        echo "Error: no skills found in $SKILLS_DIR (a skill needs a SKILL.md)" >&2
        exit 1
    fi
}

draw_menu() {
    local total_lines visible_lines start end i prefix pointer

    total_lines=$(tput lines 2>/dev/null || echo 24)
    visible_lines=$((total_lines - 8))
    if [ "$visible_lines" -lt 5 ]; then
        visible_lines=5
    fi

    start=0
    if [ "$cursor" -ge "$visible_lines" ]; then
        start=$((cursor - visible_lines + 1))
    fi

    end=$((start + visible_lines - 1))
    if [ "$end" -ge "${#skill_names[@]}" ]; then
        end=$((${#skill_names[@]} - 1))
    fi

    printf '\033[H\033[2J'
    echo "Select skills to zip"
    echo "Up/Down: move  Space: toggle  a: all  Enter: confirm  q: cancel"
    echo "Source: $SKILLS_DIR"
    echo "Output: $OUT_DIR"
    echo "Selected: $selected_count"
    echo

    for ((i = start; i <= end; i++)); do
        if [ "${selected_flags[i]}" -eq 1 ]; then
            prefix="[x]"
        else
            prefix="[ ]"
        fi

        if [ "$i" -eq "$cursor" ]; then
            pointer=">"
        else
            pointer=" "
        fi

        printf '%s %s %s\n' "$pointer" "$prefix" "${skill_names[i]}"
    done

    if [ "$start" -gt 0 ] || [ "$end" -lt $((${#skill_names[@]} - 1)) ]; then
        echo
        echo "Showing $((start + 1))-$((end + 1)) of ${#skill_names[@]} skills"
    fi
}

toggle_selection() {
    if [ "${selected_flags[cursor]}" -eq 1 ]; then
        selected_flags[cursor]=0
        selected_count=$((selected_count - 1))
    else
        selected_flags[cursor]=1
        selected_count=$((selected_count + 1))
    fi
}

select_all() {
    local i
    for ((i = 0; i < ${#skill_names[@]}; i++)); do
        selected_flags[i]=1
    done
    selected_count=${#skill_names[@]}
}

interactive_select() {
    local key

    if [ ! -t 0 ]; then
        echo "Error: no terminal for the picker. Use --all or name skills explicitly." >&2
        exit 1
    fi

    saved_stty=$(stty -g)
    trap cleanup_terminal EXIT INT TERM
    stty -echo -icanon time 0 min 1
    tput civis 2>/dev/null || true

    while true; do
        draw_menu
        IFS= read -rsn1 key

        case "$key" in
            '')
                break
                ;;
            ' ')
                toggle_selection
                ;;
            'a'|'A')
                select_all
                ;;
            'q'|'Q')
                cleanup_terminal
                echo "Cancelled" >&2
                exit 0
                ;;
            $'\x1b')
                IFS= read -rsn2 key || true
                case "$key" in
                    '[A')
                        if [ "$cursor" -gt 0 ]; then
                            cursor=$((cursor - 1))
                        fi
                        ;;
                    '[B')
                        if [ "$cursor" -lt $((${#skill_names[@]} - 1)) ]; then
                            cursor=$((cursor + 1))
                        fi
                        ;;
                esac
                ;;
        esac
    done

    cleanup_terminal
    trap - EXIT INT TERM
}

# List a skill's files relative to the skills dir. Inside a git repo, ask git so
# that .gitignore'd files (samples/, local notes) never land in an uploadable
# archive. Outside a repo, fall back to find.
list_skill_files() {
    local skill=$1

    if [ "$git_mode" -eq 1 ]; then
        git -C "$SKILLS_DIR" ls-files --cached --others --exclude-standard -- "$skill" \
            | grep -v '/\.gitignore$' || true
    else
        (cd "$SKILLS_DIR" && find "$skill" -type f \
            ! -path '*/.git/*' ! -name '.gitignore' ! -name '.DS_Store' | sort)
    fi
}

zip_skill() {
    local skill=$1
    local zip_path="$OUT_DIR/$skill.zip"
    local files

    files=$(list_skill_files "$skill")
    if [ -z "$files" ]; then
        echo "  skip $skill (no packageable files)" >&2
        return 1
    fi

    rm -f "$zip_path"
    if ! printf '%s\n' "$files" | (cd "$SKILLS_DIR" && zip -q "$zip_path" -@); then
        echo "  fail $skill" >&2
        return 1
    fi

    printf '  %-28s %s\n' "$skill" "$(du -h "$zip_path" | cut -f1)"
}

# --- argument parsing ---------------------------------------------------------

mode="pick"
names=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -s|--skills-dir)
            [ $# -ge 2 ] || { echo "Error: $1 requires a path" >&2; exit 1; }
            SKILLS_DIR=${2/#\~/$HOME}
            shift 2
            ;;
        -o|--output)
            [ $# -ge 2 ] || { echo "Error: $1 requires a path" >&2; exit 1; }
            OUT_DIR=${2/#\~/$HOME}
            shift 2
            ;;
        -a|--all)
            mode="all"
            shift
            ;;
        -l|--list)
            mode="list"
            shift
            ;;
        --clean)
            mode="clean"
            shift
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                names+=("$1")
                shift
            done
            ;;
        -*)
            echo "Error: unknown option $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            names+=("$1")
            shift
            ;;
    esac
done

if [ ${#names[@]} -gt 0 ]; then
    if [ "$mode" = "all" ]; then
        echo "Error: --all conflicts with named skills" >&2
        exit 1
    fi
    mode="named"
fi

# --- main --------------------------------------------------------------------

# Delete only the archives, never the directory: the output dir defaults to
# ~/skills, which may hold skills the user actually cares about.
if [ "$mode" = "clean" ]; then
    if [ ! -d "$OUT_DIR" ]; then
        echo "Nothing to clean: $OUT_DIR does not exist"
        exit 0
    fi
    removed=$(find "$OUT_DIR" -maxdepth 1 -type f -name '*.zip' -print -delete | wc -l | tr -d ' ')
    echo "Removed $removed zip(s) from $OUT_DIR"
    exit 0
fi

if ! command -v zip > /dev/null 2>&1; then
    echo "Error: zip is not installed" >&2
    exit 1
fi

resolve_skills_dir
discover_skills

if git -C "$SKILLS_DIR" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    git_mode=1
fi

targets=()

case "$mode" in
    list)
        printf '%s\n' "${skill_names[@]}"
        exit 0
        ;;
    all)
        targets=("${skill_names[@]}")
        ;;
    named)
        for name in "${names[@]}"; do
            found=0
            for known in "${skill_names[@]}"; do
                if [ "$name" = "$known" ]; then
                    found=1
                    break
                fi
            done
            if [ "$found" -eq 0 ]; then
                echo "Error: unknown skill '$name' in $SKILLS_DIR. Available:" >&2
                printf '  %s\n' "${skill_names[@]}" >&2
                exit 1
            fi
            targets+=("$name")
        done
        ;;
    pick)
        interactive_select
        if [ "$selected_count" -eq 0 ]; then
            echo "No skills selected" >&2
            exit 0
        fi
        for ((i = 0; i < ${#skill_names[@]}; i++)); do
            if [ "${selected_flags[i]}" -eq 1 ]; then
                targets+=("${skill_names[i]}")
            fi
        done
        ;;
esac

mkdir -p "$OUT_DIR"

echo "Zipping ${#targets[@]} skill(s)"
echo "  from $SKILLS_DIR"
echo "  to   $OUT_DIR"
if [ "$git_mode" -eq 0 ]; then
    echo
    echo "Note: $SKILLS_DIR is not a git repo, so .gitignore rules cannot be applied." >&2
    echo "      Every file is packaged. Check the archives before uploading them." >&2
fi
echo

ok=0
failed=0
for skill in "${targets[@]}"; do
    if zip_skill "$skill"; then
        ok=$((ok + 1))
    else
        failed=$((failed + 1))
    fi
done

echo
echo "Done: $ok zipped, $failed skipped"
